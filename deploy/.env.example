# 凭据模板（复制为 .env 使用，含 .env 已 gitignore）
# 与 bms 基座一致，见 bms《基座文档清单》用户文档部分

# ===== 平台接入（mdm 服务接入 bms 平台基础设施；见 deploy/compose/mdm.yml）=====
# 平台网络名：bms 部署创建的 Docker 网络名（mdm 服务加入后，平台网关方可解析 `org:8000`）
PLATFORM_NETWORK=deploy_default
# 服务镜像与标签（发布流程注入；compose 以 `:?` 强制必填，无 latest 兜底）
MDM_REGISTRY_IMAGE_PREFIX=<registry>
MDM_TAG_ORG=<tag>
# 运行库（每服务独立库 × 每租户；URL 模板占位 {service} / {tenant} / {database}，含密码经环境变量注入）
# 库名前缀 `mdm`（[database].name_prefix）→ mdm_org / mdm_org_{租户} / mdm_archive
BMS_DATABASE__PLATFORM__URL_TEMPLATE=mysql+aiomysql://mdm_app@mysql:3306/{database}
BMS_DATABASE__PLATFORM__PASSWORD=
BMS_DATABASE__TENANTS__URL_TEMPLATE=mysql+aiomysql://mdm_app@mysql:3306/{database}
BMS_DATABASE__TENANTS__PASSWORD=
# 平台依赖端点（Compose DNS；禁硬编码 IP）
BMS_REDIS__URL=redis://redis:6379/0
BMS_TRACER__OTLP_ENDPOINT=http://otel-collector:4318
# 身份密钥（服务间调用 JWT / 用户令牌校验；空值允许装配、使用时 fail-closed）
BMS_SERVICE_TOKEN__KEYS=
BMS_SERVICE_TOKEN__ACTIVE_KID=
BMS_SECURITY__KEYS=
BMS_SECURITY__ACTIVE_KID=
BMS_SECURITY__SECRET_KEY=
