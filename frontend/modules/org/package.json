{
  "name": "@mdm/module_org",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "mdm 组织域运行时模块（Module Federation remote：部门 / 岗位管理页 + 三个具名插槽插件）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:standalone": "vue-tsc -b && vite build --mode standalone",
    "preview": "vite preview",
    "budget": "node scripts/check-bundle-budget.mjs",
    "guard:isolation": "node ../../../../bms/frontend/scripts/check-module-isolation.mjs --product --module .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@bms/api_types": "file:../../../../bms/frontend/packages/api_types",
    "@bms/core": "file:../../../../bms/frontend/packages/core",
    "@bms/ui_ep": "file:../../../../bms/frontend/packages/ui_ep",
    "element-plus": "^2.14.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@mdm/api-types": "workspace:*",
    "@module-federation/vite": "1.22.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
